# ScholarAnalysis Configuration
# Copy this file to .env and fill in your values.
# All settings use the SCHOLAR_ANALYSIS_ prefix.

# --- Server ---
SCHOLAR_ANALYSIS_HOST=0.0.0.0
SCHOLAR_ANALYSIS_PORT=8005
SCHOLAR_ANALYSIS_TRANSPORT=sse
SCHOLAR_ANALYSIS_ACCESS_TOKEN=
SCHOLAR_ANALYSIS_LOG_LEVEL=INFO

# --- Backend: ArxivMirror ---
SCHOLAR_ANALYSIS_ARXIV_MIRROR_BASE_URL=http://127.0.0.1:8900/api/v1
SCHOLAR_ANALYSIS_ARXIV_MIRROR_DATA_DIR=
SCHOLAR_ANALYSIS_HTTP_TIMEOUT=600.0

# --- Backend: MinerU PDF Parser ---
# Comma-separated URLs in priority order (first one is tried first).
# Pair each endpoint with a username/password by index; leave both blank
# if that endpoint has no BasicAuth.
# Legacy single-URL fields (MINERU_BASE_URL / _USERNAME / _PASSWORD) are
# still supported as a fallback if ENDPOINTS is empty.
SCHOLAR_ANALYSIS_MINERU_ENDPOINTS=http://10.134.87.107:8888,http://10.134.87.106:8888
SCHOLAR_ANALYSIS_MINERU_USERNAMES=,mineru
SCHOLAR_ANALYSIS_MINERU_PASSWORDS=,mineru@7049
# Legacy fallback (only used if MINERU_ENDPOINTS is empty):
# SCHOLAR_ANALYSIS_MINERU_BASE_URL=http://localhost:8888
# SCHOLAR_ANALYSIS_MINERU_USERNAME=
# SCHOLAR_ANALYSIS_MINERU_PASSWORD=

# --- Temp file management ---
SCHOLAR_ANALYSIS_TEMP_DIR=/tmp/scholar-analysis
SCHOLAR_ANALYSIS_REQUEST_MAX_AGE_SECONDS=1800.0
SCHOLAR_ANALYSIS_CLEANUP_INTERVAL_SECONDS=300.0

# --- LLM: DeepSeek (primary) ---
SCHOLAR_ANALYSIS_DEEPSEEK_API_KEY=
SCHOLAR_ANALYSIS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
SCHOLAR_ANALYSIS_DEEPSEEK_MODEL=deepseek-v4-flash
SCHOLAR_ANALYSIS_DEEPSEEK_MAX_CONCURRENT=3
SCHOLAR_ANALYSIS_DEEPSEEK_THINKING=true
SCHOLAR_ANALYSIS_DEEPSEEK_CONTEXT_TOKENS=256000

# --- LLM: BigModel GLM (fallback) ---
SCHOLAR_ANALYSIS_BIGMODEL_API_KEY=
SCHOLAR_ANALYSIS_BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/chat/completions
SCHOLAR_ANALYSIS_BIGMODEL_MODEL=glm-5-turbo
SCHOLAR_ANALYSIS_BIGMODEL_MAX_CONCURRENT=3

# --- LLM: Qwen (local fallback) ---
SCHOLAR_ANALYSIS_QWEN_API_KEY=
SCHOLAR_ANALYSIS_QWEN_BASE_URL=http://localhost:8000/v1/chat/completions
SCHOLAR_ANALYSIS_QWEN_MODEL=Qwen/Qwen3.5-27B-GPTQ-Int4
SCHOLAR_ANALYSIS_QWEN_MAX_CONCURRENT=5

# --- Concurrency ---
SCHOLAR_ANALYSIS_MAX_CONCURRENT_PIPELINES=5
SCHOLAR_ANALYSIS_MAX_CONCURRENT_PARSES=3
