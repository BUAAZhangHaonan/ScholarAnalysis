# Copy to .env and fill locally. Never commit credentials.
SCHOLAR_ANALYSIS_HOST=0.0.0.0
SCHOLAR_ANALYSIS_PORT=8005
SCHOLAR_ANALYSIS_ACCESS_TOKEN=
SCHOLAR_ANALYSIS_LOG_LEVEL=INFO
SCHOLAR_ANALYSIS_ARXIV_MIRROR_BASE_URL=http://127.0.0.1:8900/api/v1
SCHOLAR_ANALYSIS_ARXIV_MIRROR_DATA_DIR=
SCHOLAR_ANALYSIS_MINERU_ENDPOINTS=
SCHOLAR_ANALYSIS_MINERU_USERNAMES=
SCHOLAR_ANALYSIS_MINERU_PASSWORDS=
SCHOLAR_ANALYSIS_HTTP_TIMEOUT=600
SCHOLAR_ANALYSIS_QUEUE_TIMEOUT_SECONDS=60
SCHOLAR_ANALYSIS_REQUEST_MAX_AGE_SECONDS=1800
SCHOLAR_ANALYSIS_TEMP_DIR=/tmp/scholar-analysis
SCHOLAR_ANALYSIS_PARSE_CACHE_DIR=data/parse_cache
SCHOLAR_ANALYSIS_PARSE_CACHE_MAX_BYTES=2147483648
SCHOLAR_ANALYSIS_DEEPSEEK_API_KEY=
SCHOLAR_ANALYSIS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
SCHOLAR_ANALYSIS_DEEPSEEK_MODEL=deepseek-flash
# Explicit alternative: deepseek-v4-pro. No automatic model/provider fallback.
SCHOLAR_ANALYSIS_DEEPSEEK_THINKING=false
SCHOLAR_ANALYSIS_DEEPSEEK_MAX_CONCURRENT=3
SCHOLAR_ANALYSIS_DEEPSEEK_CONTEXT_TOKENS=256000
SCHOLAR_ANALYSIS_RESPONSE_HEADROOM_TOKENS=16000
SCHOLAR_ANALYSIS_MAX_CONCURRENT_PIPELINES=5
SCHOLAR_ANALYSIS_MAX_CONCURRENT_PARSES=1
# Empty uses packaged prompts; an explicit directory is an intentional override.
SCHOLAR_ANALYSIS_PROMPTS_DIR=
