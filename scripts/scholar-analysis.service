[Unit]
Description=ScholarAnalysis MCP Server
After=network.target arxiv-mirror-api.service
Wants=arxiv-mirror-api.service
Documentation=https://github.com/BUAAZhangHaonan/ScholarAnalysis

[Service]
Type=simple
User=g203
Group=g203
WorkingDirectory=/home/g203/zhanghaonan/ScholarAnalysis
EnvironmentFile=/home/g203/zhanghaonan/ScholarAnalysis/.env
ExecStart=/home/g203/zhanghaonan/ScholarAnalysis/venv/bin/python -m scholar_analysis.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening (compatible with /home/g203 working directory)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictSUIDSGID=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ReadWritePaths=/home/g203/zhanghaonan/ScholarAnalysis/prompts
UMask=0077

[Install]
WantedBy=multi-user.target
